[TEMPLATE]
# ─── React Bits Pro / Starter (สำหรับติดตั้งบล็อกต้นฉบับด้วย shadcn CLI) ───
# ถ้าไม่มี license ให้ใช้คอมโพเนนต์ที่ build ไว้ในโปรเจกต์แล้ว (เหมือนเดิมได้เลย)
REACTBITS_LICENSE_KEY=

# ─── Upstash Redis (storage หลักของ content ทั้งเว็บ) ───
# ตั้งค่าอย่างใดอย่างหนึ่ง (หรือทั้งคู่) — ระบบ auto-seed ค่า default เข้า Redis
# ตอนเชื่อมครั้งแรก:
#  - Upstash (Vercel Marketplace/Storage): UPSTASH_REDIS_REST_URL / TOKEN
#  - Vercel KV: KV_REST_API_URL / TOKEN
# ถ้าไม่ตั้งค่า โปรเจกต์จะใช้ in-memory fallback (เหมาะกับ dev) แต่ข้อมูลจะไม่
# คงอยู่ข้ามการ restart
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ─── Admin login ───
# ใช้ ADMIN_PASSWORD ตั้งรหัสผ่านของ /admin (ถ้าไม่ตั้ง ใน production จะเข้าไม่ได้)
ADMIN_PASSWORD=
AUTH_SECRET=

# ─── Site URL (ใช้ใน sitemap / Open Graph) ───
NEXT_PUBLIC_SITE_URL=http://localhost:3000
